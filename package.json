{
  "name": "kyouen-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/gen-forbidden.mjs && vite",
    "dev:full": "node tools/gen-forbidden.mjs && node tools/serve-strategy.mjs --dir .strategy --port 8099 & vite --port 5173",
    "build": "node tools/gen-forbidden.mjs && vite build && node tools/vendor-strategy.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "e2e": "playwright test --config playwright.config.ts",
    "e2e:prod": "playwright test --config playwright.prod.config.ts",
    "fetch:strategy": "node tools/fetch-strategy.mjs",
    "vendor:strategy": "node tools/vendor-strategy.mjs",
    "gen:fixtures": "python tools/gen-fixtures.py",
    "gen:forbidden": "node tools/gen-forbidden.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^26.6.2",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^7.2.4",
    "vitest": "^3.0.5"
  }
}